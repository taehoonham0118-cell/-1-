<?xml version="1.0"?>
<!-- week02 | 2링크 팔 URDF (함태훈, B1)
     단위: m, kg, rad. 베이스는 천장(월드)에 고정, 팔은 -Z 방향으로 늘어짐 (q=0 이 아래로 늘어진 안정 자세).
     어깨·팔꿈치 revolute (Y축 회전).
     링크 길이 0.3 m, 각 링크 질량 1.0 kg, 관성은 균일 막대 근사 (I = m·L²/12). -->
<robot name="two_link_arm">
  <!-- week03 (10/7) 추가 | 박종진 체크리스트 v0.1 B절 반영: MuJoCo 전용 확장.
       fusestatic=false → base_link(5 kg) body 유지, discardvisual=false → visual 형상도 로드 (MuJoCo 외 파서는 이 블록을 무시) -->
  <mujoco>
    <compiler fusestatic="false" discardvisual="false" balanceinertia="false"/>
  </mujoco>

  <link name="base_link">
    <visual>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <!-- 베이스 collision은 두지 않음: MuJoCo에서 월드 고정 링크는 자식과 충돌 제외가 안 되어 어깨에 접촉력이 생김 -->
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- 어깨: base_link(부모) 프레임 기준 (0,0,-0.025) 에 위치, 축은 joint(자식) 프레임의 Y, ±150° -->
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" effort="25" velocity="5"/>
    <dynamics damping="0.1" friction="0"/>
  </joint>

  <link name="upper_arm">
    <!-- 링크는 자기 프레임 -Z 방향으로 0.3 m 뻗음. 시각/충돌 형상 중심 = -0.15 m -->
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
      <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="1.0"/>
      <!-- 균일 막대 L=0.3, m=1: I_xx=I_yy = mL²/12 = 0.0075, I_zz ≈ 0 (반지름 작음) -->
      <inertia ixx="0.0075" iyy="0.0075" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- 팔꿈치: upper_arm 끝 (0,0,-0.3), Y축 회전, -60° ~ +120° -->
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.047" upper="2.094" effort="25" velocity="5"/>
    <dynamics damping="0.1" friction="0"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
      <material name="blue"><color rgba="0.2 0.2 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0075" iyy="0.0075" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
