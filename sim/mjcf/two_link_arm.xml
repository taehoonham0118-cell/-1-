<!-- week02 | 2링크 팔 MJCF (함태훈, B1) — URDF 버전과 동일한 기하·질량·관성.
     MJCF는 body 트리 안에 joint를 넣고, inertial을 body 직속으로 쓴다. -->
<mujoco model="two_link_arm">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.001"/>

  <default>
    <joint type="hinge" axis="0 1 0" damping="0.1"/>
    <geom type="cylinder" size="0.02 0.15"/>
  </default>

  <worldbody>
    <light pos="0 0 2"/>
    <camera name="side" pos="1.5 -1.5 0.8" xyaxes="1 1 0 0 0 1"/>
    <geom name="floor" type="plane" size="1 1 0.1" pos="0 0 0" rgba="0.9 0.9 0.9 1"/>

    <body name="base_link" pos="0 0 1.0">  <!-- 천장 높이 1 m 에 고정 -->
      <!-- 베이스는 월드에 고정된 body라 자식(upper_arm)과의 부모-자식 충돌 제외가 적용되지 않음 → 충돌 끔 -->
      <geom type="box" size="0.05 0.05 0.025" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>
      <inertial pos="0 0 0" mass="5.0" diaginertia="0.01 0.01 0.01"/>

      <body name="upper_arm" pos="0 0 -0.025">
        <joint name="shoulder" range="-2.618 2.618"/>
        <geom pos="0 0 -0.15" rgba="0.8 0.2 0.2 1"/>
        <inertial pos="0 0 -0.15" mass="1.0" diaginertia="0.0075 0.0075 0.0002"/>

        <body name="forearm" pos="0 0 -0.3">
          <joint name="elbow" range="-1.047 2.094"/>
          <geom pos="0 0 -0.15" rgba="0.2 0.2 0.8 1"/>
          <inertial pos="0 0 -0.15" mass="1.0" diaginertia="0.0075 0.0075 0.0002"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_pos" joint="shoulder" kp="20" ctrlrange="-2.618 2.618" forcerange="-25 25"/>
    <position name="elbow_pos"    joint="elbow"    kp="20" ctrlrange="-1.047 2.094" forcerange="-25 25"/>
  </actuator>
</mujoco>
