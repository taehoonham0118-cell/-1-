<!-- week03 | 2링크 팔 scene (함태훈, B1)
     menagerie 의 scene.xml 패턴과 동일: 로봇 파일은 <include> 로 가져오고, 여기엔 환경(바닥·조명·카메라)만 둔다.
     실행: python -m mujoco.viewer --mjcf=sim/mjcf/scene.xml -->
<mujoco model="two_link_arm_scene">
  <include file="two_link_arm_v2.xml"/>

  <statistic center="0 0 0.6" extent="1.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <camera name="side" pos="1.5 -1.5 0.8" xyaxes="1 1 0 0 0 1"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
  </worldbody>
</mujoco>
